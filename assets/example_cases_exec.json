{
 "meta": {
  "name": "我的应用 · 接口用例（样例）",
  "base_url": "http://10.31.0.101",
  "api_prefix": "/common/idaas/v1",
  "auth": {
   "type": "header",
   "header": "app-sec-at",
   "token_env": "AUTOTEST_TOKEN",
   "probe": {
    "path": "/auth/tokenValid",
    "断言": [
     {
      "类型": "成功标志",
      "等于": true
     }
    ]
   }
  },
  "说明": "这个文件演示「10 字段用例 + 执行块」怎么写成可编译的形式。字段照旧，多一个「执行」块承载可机器执行的部分。凭据走环境变量 AUTOTEST_TOKEN，不写进文件。",
  "需求": [
   {
    "id": "R-APP-01",
    "说明": "我的应用默认查询能返回已授权应用且分页自洽"
   },
   {
    "id": "R-APP-02",
    "说明": "pageSize 越界被拒绝并提示取值范围"
   }
  ]
 },
 "cases": [
  {
   "id": "TC-APP-101",
   "所属模块": "我的应用",
   "用例标题": "默认查询返回已授权应用列表且分页字段自洽",
   "前置条件": "已登录，账号下至少有一个已授权应用",
   "测试步骤": "1. 以已登录身份请求 GET /app/my-app?status=1&pageNo=1&pageSize=5",
   "预期结果": "HTTP 200；success=true；data.records 为数组且不超过 5 条；data.pageSize 等于 5；data.total 不小于 data.records 长度",
   "优先级": "P0",
   "用例类型": "功能",
   "适用阶段": "冒烟",
   "责任人": "",
   "判定依据": "列表接口是应用中心的入口，分页字段不自洽会导致前端翻页错位。",
   "执行": {
    "步骤": [
     {
      "名称": "默认查询我的应用",
      "method": "GET",
      "path": "/app/my-app",
      "params": {
       "status": "1",
       "pageNo": "1",
       "pageSize": "5"
      },
      "断言": [
       {
        "类型": "状态码",
        "等于": 200
       },
       {
        "类型": "成功标志",
        "等于": true
       },
       {
        "类型": "JSON字段",
        "路径": "data.records",
        "是数组": true
       },
       {
        "类型": "JSON字段",
        "路径": "data.pageSize",
        "等于": 5
       },
       {
        "类型": "JSON字段",
        "路径": "data.total",
        "大于等于": 1
       }
      ]
     }
    ],
    "需求点": [
     "R-APP-01"
    ]
   }
  },
  {
   "id": "TC-APP-102",
   "所属模块": "我的应用",
   "用例标题": "pageSize 超过上限被拒绝并提示取值范围",
   "前置条件": "已登录",
   "测试步骤": "1. 请求 GET /app/my-app?status=1&pageNo=1&pageSize=501",
   "预期结果": "success=false；响应体含提示文案 1-500",
   "优先级": "P1",
   "用例类型": "边界",
   "适用阶段": "回归",
   "责任人": "",
   "判定依据": "接口声明每页 1-500，越界必须被拦截，否则一次查询可能拖垮服务。",
   "执行": {
    "步骤": [
     {
      "名称": "pageSize=501 越界",
      "method": "GET",
      "path": "/app/my-app",
      "params": {
       "status": "1",
       "pageNo": "1",
       "pageSize": "501"
      },
      "断言": [
       {
        "类型": "成功标志",
        "等于": false
       },
       {
        "类型": "包含",
        "值": "1-500"
       }
      ]
     }
    ],
    "需求点": [
     "R-APP-02"
    ]
   }
  },
  {
   "id": "TC-AUTH-101",
   "所属模块": "认证",
   "用例标题": "不带凭据查询业务接口应明确拒绝",
   "前置条件": "不携带任何身份头",
   "测试步骤": "1. 不带 app-sec-at 请求 GET /app/my-app?status=1&pageNo=1&pageSize=5",
   "预期结果": "success=false，响应中不含业务数据 records 数组",
   "优先级": "P0",
   "用例类型": "安全",
   "适用阶段": "回归",
   "责任人": "",
   "判定依据": "未认证必须被拒绝，且不能以空列表伪装成成功。",
   "执行": {
    "步骤": [
     {
      "名称": "匿名查询我的应用",
      "method": "GET",
      "path": "/app/my-app",
      "params": {
       "status": "1",
       "pageNo": "1",
       "pageSize": "5"
      },
      "no_auth": true,
      "断言": [
       {
        "类型": "成功标志",
        "等于": false
       }
      ]
     }
    ]
   }
  },
  {
   "id": "TC-MANUAL-101",
   "所属模块": "认证",
   "用例标题": "账号密码加图形验证码登录成功并下发 token",
   "前置条件": "拥有有效账号，能识别图形验证码",
   "测试步骤": "1. 打开登录页 2. 输入账号密码与验证码 3. 点击登录",
   "预期结果": "跳转到工作台，localStorage 中出现 445 字符 token",
   "优先级": "P0",
   "用例类型": "功能",
   "适用阶段": "冒烟",
   "责任人": "",
   "判定依据": "登录链路带图形验证码，当前由人工执行。",
   "执行": {
    "自动化": "manual",
    "说明": "图形验证码需要人识别；如需全自动，改用 browser_login 适配器"
   }
  }
 ]
}
