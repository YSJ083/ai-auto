{
 "name": "跨引擎汇总示例 · API 通道",
 "spec_version": "1.0",
 "base_url": "http://127.0.0.1:8899",
 "timeout": 5,
 "verify_tls": false,
 "auth": {"type": "none"},
 "cases": [
  {
   "id": "TC-API-001",
   "模块": "用户",
   "用例标题": "读取当前用户信息返回脱敏手机号",
   "优先级": "P0",
   "用例类型": "功能",
   "自动化": "auto",
   "依据": "手机号属于个人信息，任何返回路径都必须脱敏，不能给出完整号码。",
   "steps": [
    {
     "名称": "查询当前用户",
     "method": "GET",
     "path": "/user/self/info",
     "断言": [
      {"类型": "状态码", "等于": 200},
      {"类型": "成功标志", "等于": true},
      {"类型": "JSON字段", "路径": "data.id", "非空": true},
      {"类型": "JSON字段", "路径": "data.mobile", "正则": "^1\\d{2}\\*{4}\\d{4}$"}
     ]
    }
   ]
  },
  {
   "id": "TC-API-002",
   "模块": "订单",
   "用例标题": "订单列表按请求的 pageSize 返回",
   "优先级": "P1",
   "用例类型": "功能",
   "自动化": "auto",
   "依据": "pageSize 不生效会导致前端翻页错位，必须与请求一致。",
   "steps": [
    {
     "名称": "查询第 2 页，每页 10 条",
     "method": "GET",
     "path": "/orders",
     "params": {"pageNo": "2", "pageSize": "10"},
     "断言": [
      {"类型": "状态码", "等于": 200},
      {"类型": "JSON字段", "路径": "data.pageNo", "等于": 2},
      {"类型": "JSON字段", "路径": "data.pageSize", "等于": 10}
     ]
    }
   ]
  }
 ]
}
