{
 "name": "登录页 UI 样例",
 "spec_version": "1.0",
 "base_url": "http://127.0.0.1:8080",
 "api_prefix": "",
 "auth": {"type": "none"},
 "ui": {
  "headless": true,
  "timeout": 20000,
  "browser": {"channel": "chrome"},
  "viewport": {"width": 1440, "height": 900}
 },
 "_说明": [
  "这份样例演示 UI 通道的写法。三个要点：",
  "1. UI 步骤用 ui 键区分（不占用 method），带 path 就先导航；",
  "2. 断言可以是 页面/URL/控制台/网络 四类新断言，也可以用 包含 判页面文本；",
  "3. 失败会自动截图，路径进 result.json 的 steps[].screenshot。",
  "用法：auto_test.py lint 本文件 && auto_test.py run 本文件 --out ./结果"
 ],
 "cases": [
  {
   "id": "TC-UI-001",
   "模块": "登录页",
   "用例标题": "登录页加载后账号/密码/登录按钮齐全",
   "优先级": "P0",
   "用例类型": "功能",
   "自动化": "auto",
   "依据": "三个关键控件缺任何一个用户都无法登录；初始状态不应带校验提示。",
   "steps": [
    {
     "名称": "打开登录页",
     "ui": "断言快照",
     "path": "/login",
     "断言": [
      {"类型": "URL", "包含": "/login"},
      {"类型": "页面", "选择器": "input[placeholder*='账号']", "可见": true},
      {"类型": "页面", "选择器": "input[type='password']", "可见": true},
      {"类型": "页面", "选择器": "button:has-text('登录')", "可见": true},
      {"类型": "页面", "选择器": ".form-error", "数量": 0},
      {"类型": "控制台", "无错误": true}
     ]
    }
   ]
  },
  {
   "id": "TC-UI-002",
   "模块": "登录页",
   "用例标题": "空表单点登录，账号与密码都提示必填，且不跳转",
   "优先级": "P0",
   "用例类型": "异常",
   "自动化": "auto",
   "依据": "必填校验必须在发请求之前拦住，否则会向后端发送无效请求。",
   "steps": [
    {
     "名称": "打开登录页",
     "ui": "断言快照",
     "path": "/login",
     "断言": [{"类型": "URL", "包含": "/login"}]
    },
    {
     "名称": "不填内容直接点登录",
     "ui": "点击",
     "选择器": "button:has-text('登录')",
     "第几个": 0,
     "等待": {"毫秒": 1000},
     "断言": [
      {"类型": "页面", "选择器": ".form-error", "数量": 2},
      {"类型": "包含", "值": ["请输入账号", "请输入密码"]},
      {"类型": "URL", "包含": "/login"}
     ]
    }
   ]
  },
  {
   "id": "TC-UI-003",
   "模块": "登录页",
   "用例标题": "输入后原样回显，密码框为掩码类型",
   "优先级": "P1",
   "用例类型": "功能",
   "自动化": "auto",
   "依据": "密码含特殊字符时被截断是常见缺陷；密码框必须是 password 类型，否则明文显示。",
   "steps": [
    {
     "名称": "打开登录页",
     "ui": "断言快照",
     "path": "/login",
     "断言": [{"类型": "URL", "包含": "/login"}]
    },
    {
     "名称": "输入账号",
     "ui": "填写",
     "选择器": "input[placeholder*='账号']",
     "值": "zrgj",
     "断言": [{"类型": "页面", "选择器": "input[placeholder*='账号']", "值": "zrgj"}]
    },
    {
     "名称": "输入含特殊字符的密码",
     "ui": "填写",
     "选择器": "input[type='password']",
     "值": "Yb2025!@#",
     "断言": [
      {"类型": "页面", "选择器": "input[type='password']", "值": "Yb2025!@#"},
      {"类型": "页面", "选择器": "input[type='password']", "属性": {"type": "password"}}
     ]
    }
   ]
  },
  {
   "id": "TC-UI-004",
   "模块": "我的应用",
   "用例标题": "已登录状态下直接打开我的应用，列表有数据且无前端报错",
   "优先级": "P0",
   "用例类型": "功能",
   "自动化": "auto",
   "跳过原因": "这条需要真实登录态，见下面 auth 的写法；把 storage_state 生成后即可启用",
   "依据": "深链直接访问是用户收藏夹的常见入口，SPA 刷新白屏是高频缺陷。",
   "steps": [
    {
     "名称": "直接打开我的应用",
     "ui": "断言快照",
     "path": "/application/myapplication",
     "断言": [
      {"类型": "URL", "包含": "/application/myapplication"},
      {"类型": "页面", "选择器": "tbody tr", "数量": 10},
      {"类型": "控制台", "无错误": true},
      {"类型": "网络", "无失败请求": true, "允许": ["favicon"]}
     ]
    }
   ],
   "_auth 示例": {
    "type": "browser_login",
    "storage_state": "seeds/state.json",
    "token_from": "localStorage:token",
    "header": "app-sec-at",
    "probe": {"path": "/auth/tokenValid", "断言": [{"类型": "成功标志", "等于": true}]}
   }
  }
 ]
}
